{
  "name": "historias-que-nos-hacen-pensar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest --exclude e2e/**",
    "test:e2e": "set PLAYWRIGHT_BROWSERS_PATH=0&& playwright test",
    "verify:media": "tsx scripts/verify-media.ts",
    "worker:dev": "wrangler dev",
    "worker:dry-run": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest",
    "wrangler": "^4.157.0"
  }
}
